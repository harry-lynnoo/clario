<odoo>
    <record id="view_clario_ocr_settings" model="ir.ui.view">
        <field name="name">clario.ocr.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <div class="app_settings_block"
                     data-string="Clario OCR"
                     string="Clario OCR"
                     data-key="clario_ocr">

                    <h2>Clario OCR</h2>

                    <div class="row mt16 o_settings_container">

                        <div class="col-12 col-lg-6 o_setting_box">

                            <div class="o_setting_left_pane"/>

                            <div class="o_setting_right_pane">

                                <span class="o_form_label">Azure Endpoint</span>
                                <field name="azure_endpoint"
                                       placeholder="https://your-resource.cognitiveservices.azure.com"/>

                                <div class="text-muted mb8">
                                    Your Azure Document Intelligence endpoint.
                                </div>

                                <span class="o_form_label">Azure API Key</span>
                                <field name="azure_api_key"
                                       password="True"
                                       placeholder="Enter your Azure API key"/>

                                <div class="text-muted mb8">
                                    API key used for OCR processing.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </xpath>

        </field>
    </record>
</odoo>